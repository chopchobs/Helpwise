# =============================================================================
# Helpwise — Environment Variables (ตัวอย่าง)
# คัดลอกเป็น .env แล้วใส่ค่าจริง — ห้าม commit .env ที่มี secret จริง
# =============================================================================

# --- Database (Supabase PostgreSQL) ---
# DATABASE_URL: pooled connection ผ่าน pgbouncer (port 6543) — ใช้ตอน runtime
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL: direct connection (port 5432) — ใช้ตอน migrate (ห้ามผ่าน pooler)
DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# --- Supabase Storage (File Attachments) ---
# SUPABASE_URL: Project URL จาก Supabase Dashboard (เช่น https://[ref].supabase.co)
SUPABASE_URL="https://[ref].supabase.co"
# SUPABASE_SERVICE_ROLE_KEY: Service role key — server-only, bypass RLS
#   ⚠️ ห้าม expose ฝั่ง client เด็ดขาด (ไม่ใช่ prefix NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=""
# SUPABASE_STORAGE_BUCKET: ชื่อ private bucket สำหรับเก็บไฟล์แนบ ticket
#   ต้องสร้าง bucket แบบ private ใน Supabase Dashboard ก่อน deploy
#   ถ้าไม่ตั้ง จะ default เป็น "ticket-attachments"
SUPABASE_STORAGE_BUCKET="ticket-attachments"

# --- App ---
# root domain สำหรับ subdomain routing ({slug}.helpwise.com) — ห้าม hardcode
NEXT_PUBLIC_ROOT_DOMAIN="helpwise.com"

# AUTH_SECRET: secret สำหรับ sign/verify session JWT (HS256)
#   ⚠️ บังคับความยาวอย่างน้อย 32 ตัวอักษร — ไม่งั้น auth จะ throw ตอน startup
#   gen ค่าใหม่ด้วย: openssl rand -base64 48
AUTH_SECRET=""

# NEXT_PUBLIC_API_BASE_URL: base URL ที่โชว์ในหน้า Settings > API Keys
#   เป็น URL ตัวอย่างสำหรับลูกค้าที่จะเรียก public API (มี {slug} ให้แทนที่)
#   เช่น "https://{slug}.helpwise.com"
NEXT_PUBLIC_API_BASE_URL="https://{slug}.helpwise.com"

# --- Redis (Upstash) — tenant cache + BullMQ queue ---
REDIS_URL="rediss://default:[password]@[host].upstash.io:6379"

# --- Stripe (Billing) ---
# STRIPE_SECRET_KEY: Server-side secret key (ห้าม expose ฝั่ง client)
#   dev: sk_test_... | prod: sk_live_...
STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET: Webhook signing secret จาก Stripe Dashboard
#   ใช้ verify ว่า request มาจาก Stripe จริง (stripe.webhooks.constructEvent)
#   dev: ใช้ Stripe CLI: stripe listen --forward-to localhost:3000/api/webhooks/stripe/
#   production: ต้องตั้งค่า — ถ้าไม่ตั้ง webhook จะ reject ทุก request
STRIPE_WEBHOOK_SECRET="whsec_..."
# หมายเหตุ Stripe Price IDs:
#   Price ID ผูกบน Plan record ใน DB (ไม่ใช่ env var) ผ่าน field:
#     Plan.stripePriceIdMonthly และ Plan.stripePriceIdYearly
#   อัปเดตผ่าน seed (Prisma เท่านั้น — ห้าม raw SQL): prisma db seed
#   ตัวอย่าง (prisma/seed.ts): prisma.plan.update({ where: { name: "pro" },
#     data: { stripePriceIdMonthly: "price_xxx" } })

# --- Email Provider (Postmark / SendGrid) ---
# EMAIL_PROVIDER: "postmark" | "sendgrid" | ไม่ตั้ง = console stub (dev เท่านั้น)
# ปล่อยว่างใน dev เพื่อใช้ console stub (sendEmail/magic-link log ออก console)
# prod: ตั้ง "postmark" + ใส่ EMAIL_PROVIDER_API_KEY
EMAIL_PROVIDER=""
# API Key สำหรับ provider ที่เลือก (Postmark: Server API Token)
EMAIL_PROVIDER_API_KEY=""
# Email address ที่ใช้เป็น From address สำหรับ outbound email
EMAIL_FROM_ADDRESS="support@helpwise.com"

# --- Inbound Email Webhook (Postmark) ---
# Shared secret สำหรับ verify inbound webhook จาก Postmark
# ตั้งค่า webhook URL ใน Postmark Dashboard: https://{slug}.helpwise.com/api/webhooks/email/
# Secret ส่งผ่าน HTTP Basic Auth password หรือ X-Webhook-Secret header
# production: ต้องตั้งค่า — ถ้าไม่ตั้ง webhook จะ reject ทุก request
# dev: ถ้าไม่ตั้ง จะ allow (warn ใน console)
EMAIL_INBOUND_WEBHOOK_SECRET=""

# --- SLA Sweep Cron Job ---
# Shared secret สำหรับ POST /api/jobs/sla-sweep (ยิงจาก external scheduler เช่น Vercel Cron, Upstash QStash)
# ส่งผ่าน: Authorization: Bearer <secret> หรือ X-Sweep-Secret header
# production: ต้องตั้งค่า — ถ้าไม่ตั้ง sweep จะ reject ทุก request
# dev: ถ้าไม่ตั้ง จะ allow (warn ใน console)
SLA_SWEEP_SECRET=""
